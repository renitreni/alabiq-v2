APP_NAME="Alabiq"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (MySQL 8.4)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alabiq
DB_USERNAME=alabiq
DB_PASSWORD=

# Database (Docker)
# DB_CONNECTION=mysql
# DB_HOST=db
# DB_PORT=3306
# DB_DATABASE=alabiq
# DB_USERNAME=alabiq
# DB_PASSWORD=secret
# DB_ROOT_PASSWORD=rootsecret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Redis (Docker)
# REDIS_HOST=redis
# REDIS_PASSWORD=secret

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@alabiq.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Alabiq Specific Configuration
# One deployment serves one restaurant; pin it explicitly if the database may
# hold more than one restaurant record. Leave empty to use the first record.
ALABIQ_RESTAURANT_ID=
ALABIQ_CURRENCY=SAR
ALABIQ_TIMEZONE=Asia/Riyadh
ALABIQ_DEFAULT_DELIVERY_FEE=10
ALABIQ_PLATFORM_COMMISSION_RATE=0.15
ALABIQ_VAT_RATE=0.15

# Mapbox
MAPBOX_TOKEN=
ALABIQ_MAP_PROVIDER=mapbox

# Map client-side env (exposed to Vite)
VITE_MAP_PROVIDER=mapbox
VITE_MAPBOX_ACCESS_TOKEN=
VITE_MAPBOX_STYLE=mapbox://styles/mapbox/streets-v12

# Tap Payments
TAP_PAYMENTS_SECRET_KEY=
TAP_PAYMENTS_PUBLIC_KEY=
TAP_PAYMENTS_WEBHOOK_SECRET=

# MinIO (S3-compatible storage for local dev)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=alabiq
MINIO_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT="${MINIO_ENDPOINT}"
AWS_ACCESS_KEY_ID="${MINIO_ROOT_USER}"
AWS_SECRET_ACCESS_KEY="${MINIO_ROOT_PASSWORD}"
AWS_DEFAULT_REGION="us-east-1"
AWS_BUCKET="${MINIO_BUCKET}"
AWS_USE_PATH_STYLE_ENDPOINT="${MINIO_USE_PATH_STYLE_ENDPOINT}"

# Pusher (for real-time updates)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
